# Public OAuth client identifier for Google Identity Services.
# This is not a secret. Never place a client secret in this browser application.
VITE_GOOGLE_CLIENT_ID=000000000000-example.apps.googleusercontent.com

# Public site token created in Cloudflare Web Analytics. This is not a secret.
# Leave empty to disable both the consent prompt and analytics beacon.
VITE_CLOUDFLARE_WEB_ANALYTICS_TOKEN=
